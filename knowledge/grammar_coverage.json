  "audit": {
    "purpose": "Machine-readable linkage between declared V1 constructions and declarative grammar productions.",
    "rule": "A FOUNDATION construction must resolve to one or more production names in grammar_foundation.json. PARTIAL constructions may expose only implemented production names.",
